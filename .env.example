# ── AI provider (OpenAI-compatible /v1/chat/completions) ──────────────
AI_API_BASE_URL=https://sss-pluely-backend.vercel.app/v1
AI_API_KEY=your-api-key-here
# Fast primary model + fallback (fallback is used if the primary fails/returns invalid JSON)
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.8-flash
# Higher-quality model used for "Deep analysis"
# There is no offline fallback: if every model attempt fails, the user sees an error naming each failure.
AI_DEEP_MODEL=gemini-3.8-flash

# ── Sessions ──────────────────────────────────────────────────────────
# 32+ random chars. Signs the HttpOnly license/usage cookie (HS256 JWT).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Access ────────────────────────────────────────────────────────────
# Every feature is unlocked for everyone by default (no plans, no usage caps).
# Set to "false" to enforce the Free / Creator / Pro plans and limits below.
OPEN_ACCESS=
# ── Stripe (optional — without it the app runs in "demo billing" mode) ─
STRIPE_SECRET_KEY=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=

# Allow instant plan unlock without Stripe (great for previews/demos).
# Automatically ON when STRIPE_SECRET_KEY is empty. Set to "false" to disable.
DEMO_BILLING=

# Public site URL used for Stripe redirect URLs (falls back to request origin)
NEXT_PUBLIC_SITE_URL=
